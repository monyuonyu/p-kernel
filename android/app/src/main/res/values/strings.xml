<?xml version="1.0" encoding="utf-8"?>
<!--
  Base (English) strings = the fallback for any device locale not in the
  32-language manifesto set. The per-language overrides live in
  values-<qualifier>/strings.xml and are GENERATED by
  tools/android/gen_strings.py from tools/android/ui_strings.tsv.

  Strings that ARE in the table (entry screen UI) keep their English value
  here; strings that are NOT translated per-locale yet (galaxy splash, notif
  channel, the engineer/log page) live only here on purpose. English is the
  honest fallback for those until the i18n wave fills the other 30 langs.
-->
<resources>
    <string name="app_name">yurikago</string>

    <!-- Entry screen (in the i18n table — keep English value in sync here). -->
    <string name="entry_tagline">This is yurikago — where a mind that belongs to no one is raised.</string>
    <string name="entry_solo_sub">Just tap to light your own star</string>
    <string name="entry_advanced">Advanced — join a fleet</string>

    <string name="label_node_id">Node ID</string>
    <string name="label_relay_host">Relay host</string>
    <string name="label_relay_port">Relay port</string>
    <string name="label_relay_key">Relay key (hex)</string>
    <string name="label_log">Kernel log</string>

    <string name="hint_relay_host">e.g. relay.example.com</string>
    <string name="hint_relay_key">aabbcc… (64 chars)</string>

    <string name="label_lan_mesh">LAN mesh (same WiFi, no relay)</string>
    <string name="hint_lan_mesh">Both phones must use the same relay key above. Blank key = plaintext, trusted WiFi only.</string>

    <string name="btn_start">Shine</string>
    <string name="btn_stop">Stop</string>
    <string name="btn_galaxy">Open galaxy</string>

    <!-- Not yet in the per-locale table (English only for now). -->
    <string name="galaxy_title">Galaxy</string>
    <string name="galaxy_starting">Your star is waking…</string>
    <string name="galaxy_still_starting">Waking your star… If it stays dark, the battery may be low — plug in.</string>

    <string name="notif_channel_name">yurikago</string>
    <string name="notif_channel_desc">Stays here while your star is shining.</string>
    <string name="notif_content">yurikago · your star</string>
    <string name="galaxy_lighting">Lighting your star…</string>
    <string name="galaxy_charge">Battery is low — plug in to relight your star</string>
    <string name="galaxy_wifi_wait">Waiting for Wi‑Fi to relight your star</string>
    <string name="galaxy_menu_desc">advanced settings</string>
    <string name="star_lit">Your star is shining right now</string>
    <string name="star_dark">Your star is asleep right now</string>
    <string name="btn_sleep">Let it sleep</string>
    <string name="btn_copy">Copy</string>

    <!-- Battery-safe toggle (advanced screen). In the i18n table (en+ja). -->
    <string name="pref_battery_safe">Battery protection</string>

    <!-- New advanced-screen settings (i18n table: en+ja now; 30 langs later).
         pref_floor_label takes the live floor % via getString(..., floor). -->
    <string name="pref_floor_label">Pause below %1$d%%</string>
    <string name="pref_wifi_only">Wi-Fi only (unmetered)</string>
    <string name="pref_start_on_boot">Start when the phone turns on</string>
    <!-- GPU toggle (advanced screen). Default OFF (honestly experimental + the
         native default is disabled). pref_use_gpu_unavailable replaces the
         label, greyed, when the device has no usable Vulkan. (en+ja in the
         table; other langs fall back to English.) -->
    <string name="pref_use_gpu">Use GPU (experimental)</string>
    <string name="pref_use_gpu_unavailable">GPU not available on this device</string>
    <string name="reintro_btn">View introduction again</string>

    <!-- Settings layer (3-layer-discover wave): a clear header so a first-time
         owner knows this is settings, and the app version line (en+ja in the
         table; other langs fall back to English). app_version_fmt takes the
         versionName via getString(..., name). -->
    <string name="settings_header">Settings</string>
    <string name="app_version_fmt">yurikago %1$s</string>

    <!-- Advanced page (LogActivity). Deliberately technical; the body labels
         are English-only for now (i18n wave can translate later). The page
         TITLE + entry button are now in the i18n table (adv_screen column:
         en "Advanced" / ja "アドバンスド"; other langs fall back to base
         "Advanced") — never "Engineer". -->
    <!-- engineer_title / btn_engineer are GENERATED per-locale from the
         adv_screen column; the base values keep the English "Advanced". -->
    <string name="btn_engineer">Advanced</string>
    <string name="engineer_title">Advanced</string>
    <string name="engineer_internals">Node internals</string>
    <string name="engineer_modules">Modules</string>
    <string name="engineer_log">Raw kernel log</string>
    <string name="engineer_unavailable">—</string>
    <!-- Fleet / relay (advanced) fields, moved here from the friendly layer. -->
    <string name="engineer_fleet">Fleet / relay (advanced)</string>
    <string name="engineer_fleet_save">Save &amp; relight node</string>
    <!-- Resources / CPU section (engineer-stats wave): REAL measurements off
         /proc — system CPU% + this node's process CPU% + core count. GPU is
         stated honestly (no fabricated %) because Android exposes no portable
         GPU-usage API and inference runs on the CPU. (en+ja in the table; the
         other 30 fall back to English, like the rest of the engineer page.) -->
    <string name="engineer_resources">Resources / CPU</string>
    <string name="engineer_measuring">measuring…</string>
    <!-- Device-wide CPU% is denied to third-party apps by SELinux (API 26+):
         /proc/stat's aggregate line is unreadable and there is no fake-free
         way to get it. Shown honestly instead of a bare "n/a" (Bug 2). -->
    <string name="engineer_cpu_restricted">unavailable (OS restriction)</string>
    <string name="engineer_gpu_unused">not used (CPU inference)</string>
    <!-- HONEST GPU status (gpu-ui wave): read from the GPU-1/GPU-2 natives.
         The mind STILL runs inference on the CPU — GPU-3 wires the matmul to
         the GPU — so the available line MUST say "not yet used for inference
         (CPU)". Never claim GPU inference work that isn't happening.
         engineer_gpu_available is a format string:
           %1$s = device name (gpu_name(), e.g. "Adreno (TM) 840")
           %2$s = enabled state (engineer_gpu_enabled / engineer_gpu_off) -->
    <string name="engineer_gpu_unavailable">not available on this device</string>
    <string name="engineer_gpu_available">%1$s · available · %2$s · not yet used for inference (CPU)</string>
    <string name="engineer_gpu_enabled">enabled (settings)</string>
    <string name="engineer_gpu_off">off</string>
</resources>
