<?xml version="1.0" encoding="utf-8"?>
<!--
  Base (English) strings = the fallback for any device locale not in the
  32-language manifesto set. The per-language overrides live in
  values-<qualifier>/strings.xml and are GENERATED by
  tools/android/gen_strings.py from tools/android/ui_strings.tsv.

  Strings that ARE in the table (entry screen UI) keep their English value
  here; strings that are NOT translated per-locale yet (galaxy splash, notif
  channel) live only here on purpose.
-->
<resources>
    <string name="app_name">UMP</string>

    <!-- Entry screen (in the i18n table — keep English value in sync here). -->
    <string name="entry_tagline">This is p-kernel — a home for an AI that belongs to no one.</string>
    <string name="entry_solo_sub">Just tap to light your own star</string>
    <string name="entry_advanced">Advanced — join a fleet</string>

    <string name="label_node_id">Node ID</string>
    <string name="label_relay_host">Relay host</string>
    <string name="label_relay_port">Relay port</string>
    <string name="label_relay_key">Relay key (hex)</string>
    <string name="label_log">Kernel log</string>

    <string name="hint_relay_host">e.g. relay.example.com</string>
    <string name="hint_relay_key">aabbcc… (64 chars)</string>

    <string name="btn_start">Shine</string>
    <string name="btn_stop">Stop</string>
    <string name="btn_galaxy">Open galaxy</string>

    <!-- Not yet in the per-locale table (English only for now). -->
    <string name="galaxy_title">Galaxy</string>
    <string name="galaxy_starting">Your star is waking…\n\nconnecting to the galaxy on 127.0.0.1:%1$d</string>
    <string name="galaxy_still_starting">Still waking the kernel on 127.0.0.1:%1$d.\n\nIf this persists, the node may be in charge-only mode — connect power, or press Start on the previous screen.</string>

    <string name="notif_channel_name">p-kernel node</string>
    <string name="notif_channel_desc">Persistent notification while the kernel is running.</string>
</resources>
