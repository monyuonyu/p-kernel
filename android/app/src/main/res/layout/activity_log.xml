<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_log.xml — the ENGINEER page (LogActivity), layer 3.

  Deliberately technical / console-styled (the ONE place jargon is allowed,
  per docs/product-soul.md): monospace, near-black background. It carries:
    · app version (yurikago <versionName>) + build id,
    · node internals,
    · the name->version module table (GET /modules.json),
    · the raw kernel stdout tail (with a copy button), and
    · the Fleet / relay (advanced) fields — node id / relay host/port/key,
      moved here from the friendly Settings layer (3-layer-discover wave).
  Reached only from the "Engineer / advanced" button on the Settings layer;
  exported=false.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/log_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/engineer_title"
            android:textColor="@color/log_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:paddingBottom="2dp"/>

        <!-- App version (yurikago <versionName>) — filled at runtime. -->
        <TextView
            android:id="@+id/app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/sky_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:paddingBottom="12dp"/>

        <!-- Node internals -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/engineer_internals"
            android:textColor="@color/sky_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/internals_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/log_text"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:paddingBottom="14dp"/>

        <!-- Module-version table (GET /modules.json) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/engineer_modules"
            android:textColor="@color/sky_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/modules_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/log_text"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:paddingBottom="14dp"/>

        <!-- ============ Resources / CPU (REAL measurements) =============
             System CPU% sampled off /proc/stat (no permission needed) +
             core count + this node's own process CPU%. GPU is shown HONESTLY:
             Android exposes no portable GPU-usage API and inference runs on
             the CPU, so we say so rather than fabricate a number. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/engineer_resources"
            android:textColor="@color/sky_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingBottom="4dp"/>
        <TextView
            android:id="@+id/resources_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/log_text"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:paddingBottom="14dp"/>

        <!-- Raw kernel log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/engineer_log"
                android:textColor="@color/sky_dim"
                android:textSize="12sp"
                android:fontFamily="monospace"/>
            <Button
                android:id="@+id/btn_copy_log"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_copy"
                android:textColor="@color/log_text"
                android:textSize="12sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
        <!-- Bounded, independently-scrollable log region. The page's outer
             ScrollView would otherwise grow without limit as the log fills;
             this fixed-height inner ScrollView keeps the latest tail visible
             (LogActivity auto-scrolls it to the bottom on append) while the
             reader can still drag up through the history. -->
        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/log_bg"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">
            <TextView
                android:id="@+id/log_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/log_text"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textIsSelectable="true"
                android:padding="6dp"/>
        </ScrollView>

        <!-- ============ Fleet / relay (advanced) ======================
             The technical fleet fields, moved out of the friendly Settings
             layer (3-layer-discover wave): node id + relay host/port/key.
             These persist to the "ump" prefs and feed PKernelService via the
             same intent-extra plumbing; "Save &amp; relight" restarts the
             node with the new values. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:background="@color/sky_faint"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/engineer_fleet"
            android:textColor="@color/log_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_node_id"
            android:textColor="@color/sky_faint"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingBottom="2dp"/>
        <EditText
            android:id="@+id/field_node_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/log_text"
            android:textColorHint="@color/sky_faint"
            android:fontFamily="monospace"
            android:paddingBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_relay_host"
            android:textColor="@color/sky_faint"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
        <EditText
            android:id="@+id/field_relay_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/hint_relay_host"
            android:textColor="@color/log_text"
            android:textColorHint="@color/sky_faint"
            android:fontFamily="monospace"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_relay_port"
            android:textColor="@color/sky_faint"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingTop="8dp"/>
        <EditText
            android:id="@+id/field_relay_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@color/log_text"
            android:textColorHint="@color/sky_faint"
            android:fontFamily="monospace"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_relay_key"
            android:textColor="@color/sky_faint"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:paddingTop="8dp"/>
        <EditText
            android:id="@+id/field_relay_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/hint_relay_key"
            android:textColor="@color/log_text"
            android:textColorHint="@color/sky_faint"
            android:fontFamily="monospace"/>

        <Button
            android:id="@+id/btn_relay_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/engineer_fleet_save"
            android:textColor="@color/log_text"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>
</ScrollView>
