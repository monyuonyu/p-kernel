<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — the SETTINGS layer (3-layer-discover wave).

  Three CLEAN, FINDABLE layers (docs/product-soul.md: users don't care about
  kernels; 0.6.3 feedback: the layers were undiscoverable):
    1. GALAXY (GalaxyActivity): the sky + a VISIBLE ⚙ gear into Settings.
    2. SETTINGS (THIS screen, reached via the gear): a clear "Settings"
       header, the FRIENDLY controls (battery-safe · battery floor · Wi-Fi
       only · start-on-boot), "View introduction again", the app version,
       and ONE clearly-labelled "Engineer / advanced" door. NO raw relay
       host/port/hex-key here — those moved to the engineer page.
    3. ENGINEER (LogActivity): build id + 24-module version table + node
       internals + raw log + the technical Fleet/relay fields. Jargon lives
       here and only here.

  The friendly settings are shown DIRECTLY (no "Advanced" tap to reveal);
  the only opt-in/collapse left is the deeper engineer page.

  StarfieldView backdrop (the galaxy.html universe). start/end (not left/right)
  so RTL locales (ar, fa, ur) mirror correctly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_bg">

    <io.pkernel.StarfieldView
        android:id="@+id/starfield"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/app_name"
                android:textColor="@color/star_white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:paddingBottom="2dp"/>

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@color/star_blue"/>

            <!-- Localized tagline (human-approved manifesto line 3). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_tagline"
                android:textColor="@color/sky_dim"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:fontFamily="monospace"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="36dp"/>

            <!-- state, in human words: shining / asleep (localized) -->
            <TextView
                android:id="@+id/star_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/star_blue"
                android:textSize="15sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"/>

            <!-- HERO: the one button. 灯す (localized); hidden while shining. -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:text="@string/btn_start"
                android:textColor="@color/star_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_hero"/>

            <!-- 眠らせる: hidden while asleep; swapped in by the poller. -->
            <Button
                android:id="@+id/btn_stop"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:text="@string/btn_sleep"
                android:textColor="@color/sky_dim"
                android:textSize="18sp"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_solo_sub"
                android:textColor="@color/sky_faint"
                android:textSize="12sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:paddingTop="10dp"
                android:paddingBottom="14dp"/>

            <!-- Open galaxy (the observation window). -->
            <Button
                android:id="@+id/btn_galaxy"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_galaxy"
                android:textColor="@color/star_blue"
                android:fontFamily="monospace"
                android:paddingBottom="18dp"/>

            <!-- ============ SETTINGS layer (always visible) =============== -->
            <!-- A clear header so a first-time owner KNOWS this is settings. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_header"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="2dp"/>

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:background="@color/sky_faint"/>

            <!-- Battery-safe toggle (PREF_CHARGE_ONLY; default on).
                 SwitchCompat (not <Switch>) so the Kotlin cast matches
                 under the AppCompat theme's auto-inflation. -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_battery_safe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_battery_safe"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingTop="6dp"
                android:paddingBottom="14dp"/>

            <!-- Battery floor %: a SeekBar (10..50, step 5, default 30).
                 The label above shows the live value ("Pause below 30%").
                 Stored in PREF_BATTERY_FLOOR; powerAllowed() reads it. -->
            <TextView
                android:id="@+id/label_battery_floor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_floor_label"
                android:textColor="@color/sky_faint"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingBottom="2dp"/>
            <SeekBar
                android:id="@+id/seek_battery_floor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="8"
                android:paddingBottom="14dp"/>

            <!-- WiFi-only (PREF_WIFI_ONLY; default off): run only on
                 unmetered WiFi. SwitchCompat (not <Switch>) for the cast. -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_wifi_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_wifi_only"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingBottom="14dp"/>

            <!-- Start-on-boot (PREF_START_ON_BOOT; default off): relight
                 the node after the device boots. SwitchCompat. -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_start_on_boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_start_on_boot"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingBottom="14dp"/>

            <!-- Use-GPU toggle (PREF_USE_GPU; default OFF — honestly
                 experimental, matches the native default). Disabled + relabelled
                 "GPU not available on this device" when nativeGpuAvailable() is
                 false. SwitchCompat (not <Switch>) so the Kotlin cast matches. -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_use_gpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_use_gpu"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingBottom="14dp"/>

            <!-- Replay the picture-book intro (pictures only, no re-consent). -->
            <Button
                android:id="@+id/btn_reintro"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reintro_btn"
                android:textColor="@color/sky_faint"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp"/>

            <!-- App version — so the owner can SEE which yurikago they run
                 (0.6.3 feedback: the version was shown nowhere). Filled at
                 runtime: "yurikago <versionName>". -->
            <TextView
                android:id="@+id/app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/sky_faint"
                android:textSize="12sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"/>

            <!-- The ONE clearly-labelled door to the engineer / advanced
                 layer: raw log + module versions + the technical fleet/relay
                 fields. -->
            <Button
                android:id="@+id/btn_engineer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_engineer"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
