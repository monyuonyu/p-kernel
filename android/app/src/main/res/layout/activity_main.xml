<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — the FRIENDLY surface (app-polish wave).

  Three layers (docs/product-soul.md: users don't care about kernels):
    1. SURFACE (this column, always visible): app name · localized tagline ·
       star status (shining/asleep) · the one hero button (灯す/眠らせる) ·
       Open galaxy. NO raw kernel log here, NO jargon.
    2. SETTINGS ("▸ Advanced — join a fleet", collapsed): battery-safe toggle,
       relay host/port/key (opt-in fleet join), and the door to the engineer
       page. Intent extras to PKernelService are UNCHANGED.
    3. ENGINEER (LogActivity, opened from the button below): the raw stdout
       tail + node internals + module versions. Deliberately technical.

  StarfieldView backdrop (the galaxy.html universe). start/end (not left/right)
  so RTL locales (ar, fa, ur) mirror correctly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_bg">

    <io.pkernel.StarfieldView
        android:id="@+id/starfield"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/app_name"
                android:textColor="@color/star_white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:paddingBottom="2dp"/>

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@color/star_blue"/>

            <!-- Localized tagline (human-approved manifesto line 3). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_tagline"
                android:textColor="@color/sky_dim"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:fontFamily="monospace"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="36dp"/>

            <!-- state, in human words: shining / asleep (localized) -->
            <TextView
                android:id="@+id/star_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/star_blue"
                android:textSize="15sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:paddingBottom="12dp"/>

            <!-- HERO: the one button. 灯す (localized); hidden while shining. -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:text="@string/btn_start"
                android:textColor="@color/star_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_hero"/>

            <!-- 眠らせる: hidden while asleep; swapped in by the poller. -->
            <Button
                android:id="@+id/btn_stop"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:text="@string/btn_sleep"
                android:textColor="@color/sky_dim"
                android:textSize="18sp"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_solo_sub"
                android:textColor="@color/sky_faint"
                android:textSize="12sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:paddingTop="10dp"
                android:paddingBottom="14dp"/>

            <!-- Open galaxy (the observation window). -->
            <Button
                android:id="@+id/btn_galaxy"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_galaxy"
                android:textColor="@color/star_blue"
                android:fontFamily="monospace"
                android:paddingBottom="18dp"/>

            <!-- ============ SETTINGS layer (collapsed by default) ========= -->
            <TextView
                android:id="@+id/advanced_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_advanced"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"/>

            <LinearLayout
                android:id="@+id/advanced_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="6dp">

                <!-- Battery-safe toggle (PREF_CHARGE_ONLY; default on).
                     SwitchCompat (not <Switch>) so the Kotlin cast matches
                     under the AppCompat theme's auto-inflation. -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_battery_safe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_battery_safe"
                    android:textColor="@color/sky_dim"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:paddingTop="6dp"
                    android:paddingBottom="14dp"/>

                <!-- Node id — only needed when joining a fleet. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_node_id"
                    android:textColor="@color/sky_faint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:paddingBottom="2dp"/>
                <EditText
                    android:id="@+id/field_node_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="1"
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/sky_faint"
                    android:fontFamily="monospace"
                    android:paddingBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_relay_host"
                    android:textColor="@color/sky_faint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>
                <EditText
                    android:id="@+id/field_relay_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="@string/hint_relay_host"
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/sky_faint"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_relay_port"
                    android:textColor="@color/sky_faint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:paddingTop="8dp"/>
                <EditText
                    android:id="@+id/field_relay_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="7400"
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/sky_faint"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_relay_key"
                    android:textColor="@color/sky_faint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:paddingTop="8dp"/>
                <EditText
                    android:id="@+id/field_relay_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="@string/hint_relay_key"
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/sky_faint"
                    android:fontFamily="monospace"/>

                <!-- The door to the engineer page (raw log + internals). -->
                <Button
                    android:id="@+id/btn_engineer"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_engineer"
                    android:textColor="@color/sky_faint"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
