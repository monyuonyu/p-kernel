<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — UMP entry screen, redesigned (i18n + ワクワク wave).

  A StarfieldView backdrop (the same dark galaxy.html universe) behind a
  scrollable column:
      app name  ·  localized tagline (manifesto line 3)
      node id
      [ SHINE ]  hero button  ·  solo subtitle
      ▸ Advanced — join a fleet   (collapsed; relay host/port/key)
      Stop · Open galaxy
      kernel log (tail)

  Solo works with no relay: a first-time user just taps SHINE. The relay
  fields live in the collapsed "advanced" group. Intent extras to
  PKernelService are UNCHANGED — the fields still exist, just hidden by
  default. Uses start/end (not left/right) so RTL locales (ar, fa, ur)
  mirror correctly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sky_bg">

    <io.pkernel.StarfieldView
        android:id="@+id/starfield"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/app_name"
                android:textColor="@color/star_white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:paddingBottom="2dp"/>

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@color/star_blue"/>

            <!-- Localized tagline (human-approved manifesto line 3). -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_tagline"
                android:textColor="@color/sky_dim"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:fontFamily="monospace"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="36dp"/>

            <!-- Node id — the only field a solo star needs (defaults to 1). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_node_id"
                android:textColor="@color/sky_faint"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingBottom="2dp"/>
            <EditText
                android:id="@+id/field_node_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1"
                android:textColor="@color/star_white"
                android:textColorHint="@color/sky_faint"
                android:fontFamily="monospace"
                android:paddingBottom="20dp"/>

            <!-- HERO: the one button. "Shine" / 光れ (localized). -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                android:text="@string/btn_start"
                android:textColor="@color/star_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_hero"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_solo_sub"
                android:textColor="@color/sky_faint"
                android:textSize="12sp"
                android:gravity="center"
                android:fontFamily="monospace"
                android:paddingTop="10dp"
                android:paddingBottom="20dp"/>

            <!-- Advanced toggle (collapsed by default). -->
            <TextView
                android:id="@+id/advanced_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/entry_advanced"
                android:textColor="@color/sky_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?android:attr/selectableItemBackground"/>

            <!-- Advanced group: relay host/port/key. GONE until tapped. -->
            <LinearLayout
                android:id="@+id/advanced_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_relay_host"
                    android:textColor="@color/sky_faint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>
                <EditText
                    android:id="@+id/field_relay_host"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="@string/hint_relay_host"
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/sky_faint"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_relay_port"
                    android:textColor="@color/sky_faint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:paddingTop="8dp"/>
                <EditText
                    android:id="@+id/field_relay_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="7400"
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/sky_faint"
                    android:fontFamily="monospace"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_relay_key"
                    android:textColor="@color/sky_faint"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:paddingTop="8dp"/>
                <EditText
                    android:id="@+id/field_relay_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="@string/hint_relay_key"
                    android:textColor="@color/star_white"
                    android:textColorHint="@color/sky_faint"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Stop · Open galaxy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="22dp"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btn_stop"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_stop"
                    android:textColor="@color/sky_dim"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btn_galaxy"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_galaxy"
                    android:textColor="@color/star_blue"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- Kernel log (tail). -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_log"
                android:textColor="@color/sky_faint"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/log_view"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/log_bg"
                android:textColor="@color/log_text"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:padding="6dp"
                android:scrollbars="vertical"
                android:gravity="top"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
