<?xml version="1.0" encoding="utf-8"?>
<!--
  UMP AndroidManifest.

  Permissions:
    INTERNET          — net_relay.c opens a UDP socket to the public relay.
    FOREGROUND_SERVICE
    FOREGROUND_SERVICE_DATA_SYNC
                      — Android 14+ requires a typed FGS declaration.
                        "dataSync" fits a node syncing K-DDS state with peers;
                        not "connectedDevice" (that's for BLE/USB).
    POST_NOTIFICATIONS — Android 13+ runtime permission for the persistent
                         notification the foreground service posts.
    WAKE_LOCK         — keep CPU running while the kernel is up. Combined
                         with the battery-safe floor (run to ~30%, then pause
                         until plugged in) this stays battery-safe.
  Battery state (level + plug) is read from the sticky ACTION_BATTERY_CHANGED
  broadcast, which needs no permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.UMP"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- galaxy.md D4: the WebView window onto 127.0.0.1:7800+(node_id-1).
             Cleartext is permitted ONLY for loopback (network_security_config). -->
        <activity
            android:name=".GalaxyActivity"
            android:exported="false"
            android:label="@string/galaxy_title"/>

        <service
            android:name=".PKernelService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- battery-safe RESUME: after a low-battery stopSelf() (which kills
             the process + its runtime receiver) this manifest receiver wakes
             on plug-in and relaunches the service with the persisted boot
             params. ACTION_POWER_CONNECTED is a protected system broadcast,
             so exported=false is correct (only the system delivers it). -->
        <receiver
            android:name=".PowerConnectedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
