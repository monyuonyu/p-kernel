<?xml version="1.0" encoding="utf-8"?>
<!--
  UMP AndroidManifest.

  Permissions:
    INTERNET          — net_relay.c opens a UDP socket to the public relay.
    FOREGROUND_SERVICE
    FOREGROUND_SERVICE_DATA_SYNC
                      — Android 14+ requires a typed FGS declaration.
                        "dataSync" fits a node syncing K-DDS state with peers;
                        not "connectedDevice" (that's for BLE/USB).
    POST_NOTIFICATIONS — Android 13+ runtime permission for the persistent
                         notification the foreground service posts.
    WAKE_LOCK         — keep CPU running while the kernel is up. Combined
                         with the battery-safe floor (run to ~30%, then pause
                         until plugged in) this stays battery-safe.
    CHANGE_WIFI_MULTICAST_STATE
                      — N-1b LAN-DIRECT mesh: lets the app hold a
                         WifiManager.MulticastLock so inbound UDP broadcast is
                         delivered (Android drops it otherwise). Only used when
                         the off-by-default "LAN mesh" toggle is ON.
  Battery state (level + plug) is read from the sticky ACTION_BATTERY_CHANGED
  broadcast, which needs no permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- CHANGE_WIFI_MULTICAST_STATE — N-1b LAN-DIRECT mesh. Android SILENTLY
         drops inbound UDP broadcast/multicast to an app without a held
         WifiManager.MulticastLock; the lock requires this permission. Only
         exercised while the (off-by-default) "LAN mesh" toggle is ON. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- RECEIVE_BOOT_COMPLETED — a NORMAL permission. Required by
         JobInfo.setPersisted(true) so the charge-resume job survives a reboot:
         a node paused at the battery floor resumes if the phone is rebooted
         while charging. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.UMP"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- galaxy.md D4: the WebView window onto 127.0.0.1:7800+(node_id-1).
             Cleartext is permitted ONLY for loopback (network_security_config). -->
        <activity
            android:name=".GalaxyActivity"
            android:exported="false"
            android:label="@string/galaxy_title"/>

        <!-- The ENGINEER page (layer 3): raw kernel log + node internals +
             module versions. Deliberately technical; reached only from the
             advanced settings on MainActivity. exported=false. -->
        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/engineer_title"/>

        <service
            android:name=".PKernelService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- battery-safe RESUME: after a low-battery stopSelf() (which kills
             the process + its runtime receiver) the JobScheduler runs this
             JobService when the charging constraint is met. A running
             JobService is an allowed context to start an FGS on Android 12+,
             unlike a background ACTION_POWER_CONNECTED receiver (which throws
             ForegroundServiceStartNotAllowedException). BIND_JOB_SERVICE lets
             only the system bind it; exported=false. -->
        <service
            android:name=".ResumeJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>

        <!-- Optional start-on-boot (PREF_START_ON_BOOT, default off): relight
             the node after the device boots. A BOOT_COMPLETED receiver IS an
             allowed context to start a foreground service (it is on Android's
             closed exemption list), unlike a background ACTION_POWER_CONNECTED
             receiver. exported=false; only the system delivers BOOT_COMPLETED.
             RECEIVE_BOOT_COMPLETED is already declared above. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
