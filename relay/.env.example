# Copy to .env and fill in. .env is gitignored — never commit the real key.
#
# Shared secret for the v2 wire (HMAC-SHA256). EXACTLY 64 hex chars.
# The SAME value must be set as PKERNEL_RELAY_KEY on every node that joins.
# Generate a fresh one with:  openssl rand -hex 32
PKERNEL_RELAY_KEY=REPLACE_WITH_64_HEX_CHARS
